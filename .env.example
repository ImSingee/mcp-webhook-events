# mwe-server configuration. Copy to .env and fill in; never commit .env.

# Required: the one password of the admin UI and the OAuth consent page.
# Use a long random value, e.g. `openssl rand -base64 24`.
MWE_PASSWORD=change-me-to-a-long-random-password

# Required: the public origin the server is reached at (no path). It is the
# OAuth issuer, the MCP resource (<url>/mcp) and the base of webhook URLs.
# Must be https unless the host is localhost.
MWE_PUBLIC_URL=http://localhost:8080

# Listen address (default :8080).
MWE_ADDR=:8080

# Where mwe.db lives (default ./data; /data in the Docker image).
MWE_DATA_DIR=./data

# How long events are kept for replay and the UI (default 168h).
MWE_EVENT_RETENTION=168h

# Largest webhook body accepted, in bytes (default 262144 = 256 KiB).
MWE_MAX_BODY_BYTES=262144

# Trust X-Forwarded-For from a reverse proxy for client IPs (default false).
MWE_TRUST_PROXY=false

# Development only: let webhook-mode subscriptions deliver to http:// and
# private/loopback addresses (default false).
MWE_ALLOW_PRIVATE_CALLBACKS=false

# Callback origins (comma-separated) trusted without the verification
# handshake for webhook-mode subscriptions, e.g. https://hooks.example.com.
MWE_CALLBACK_ALLOWLIST=

# debug, info, warn or error (default info).
MWE_LOG_LEVEL=info
